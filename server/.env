SUPABASE_URL=
SUPABASE_KEY=

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8765
# Recording Configuration
DEFAULT_CODEC=VP9
DEFAULT_CONTAINER=webm
DEFAULT_RESOLUTION=640x480
DEFAULT_FPS=30

# Performance Settings
LOG_BUFFER_SIZE=50
LOG_FLUSH_INTERVAL=10.0
PERFORMANCE_LOG_INTERVAL=60.0

# Motion Detection
DEFAULT_SENSITIVITY=20
DEFAULT_AREA_THRESHOLD=5000

# WebRTC STUN/TURN Configuration
WEBRTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302,stun:stun3.l.google.com:19302,stun:stun4.l.google.com:19302
WEBRTC_TURN_SERVER=turn:127.0.0.1:3478
WEBRTC_TURN_USERNAME=webrtc
WEBRTC_TURN_CREDENTIAL=webrtc123
#Model Size Configuration - Nano, Small, Medium, Large, Custom
MODEL_SIZE=Nano
MODEL_CHECKPOINT_PATH=./checkpoints/yolo26n_float32.tflite

